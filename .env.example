# AX Explorer 环境变量配置示例
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# 修改后需重启 make dev / pnpm tauri dev
#
# 注意：TAURI_ENV_ / 非前缀变量只在 Rust 端与构建脚本可见；
# LLM 密钥由 Rust 端读取（llm.rs），不会被打包进前端代码。

# ============================================================
# LLM（🤖 智能模式用，OpenAI 兼容 API）
# 推荐接本机 tsm-hub 网关（work/golang/tsm-hub）：统一管理上游多厂商、
# 自制 sk-tr-… 密钥、智能路由、fastpath、技能注入（Agent Skills）。
# 也可直连 DeepSeek / OpenAI / 通义 / Kimi / 本地 Ollama 等。
# ============================================================

# API 地址（OpenAI 兼容格式）
# 已含 /v1 后缀时不会重复拼接，两种写法都支持：
#   tsm-hub 网关:   http://localhost:9070/v1
#   DeepSeek:       https://api.deepseek.com
#   本地 Ollama:    http://127.0.0.1:11434
AX_EXPLORER_LLM_BASE_URL=http://localhost:9070/v1

# API 密钥
# tsm-hub 用户：填网关签发的自制密钥（管理台 Keys 页签发，形如 sk-tr-…）。
# ax-explorer 对应的 key 名为 ax-explore；inject_skills="list" 时网关会把
# 技能清单自动注入 system prompt。
AX_EXPLORER_LLM_API_KEY=sk-tr-your-hub-key-here

# 模型名
# tsm-hub 用户：填路由别名（smart / cheap / auto），auto = 网关按内容自动选场景；
# 直连厂商时填真实模型名（deepseek-chat / gpt-4o / qwen-plus 等）。
AX_EXPLORER_LLM_MODEL=auto

# ============================================================
# tsm-hub 网关侧建议（在 hub 的管理台/配置里做）
# ============================================================
# · keys[] 里为 ax-explorer 发一个 key（models 留空 = 不限别名）；
# · inject_skills: "list" —— 网关自动把技能清单注入 system prompt，
#   模型按需通过本应用工具 use_skill 拉取全文；
# · settings.skills_dir 指向技能库（Docker 部署需把 skills/ 挂进容器：
#   -v ./skills:/skills 且 skills_dir=/skills/resolve-skills/skills）。

# ============================================================
# 个人资料 RAG（工具 profile_search 用，本地 langchain-llm-toolkit）
# ============================================================
# 服务地址与内部访问凭据（loopback 自建服务）。缺省 URL 为 8001；
# PROFILE_RAG_KEY 必填（服务端实际下发的 X-API-Key）。
PROFILE_RAG_URL=http://127.0.0.1:8001
PROFILE_RAG_KEY=your-rag-key-here

# ============================================================
# 说明
# ============================================================
# 1. .env 已在 .gitignore 中忽略，不会被提交；密钥只存本地。
# 2. 优先级：应用内 ⚙️ 设置（app_data_dir/llm.json，一次配置永久生效）
#        > .env 环境变量 > 内置默认值（DeepSeek 占位）。
#    ⚙️ 面板里保存过配置后，.env 中的改动不会再生效；
#    想改用 .env，删除 ~/Library/Application Support/cn.erishen.ax-explorer/llm.json。
# 3. 也可不经 .env，直接在系统环境变量里 export 同名变量后启动 dev。
