{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AX Explorer",
  "version": "0.1.0",
  "identifier": "cn.erishen.ax-explorer",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AX Explorer — macOS Accessibility Inspector",
        "width": 1080,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
